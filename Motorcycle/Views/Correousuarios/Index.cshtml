@model IEnumerable<Motorcycle.Models.Correousuario>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Listado de Correos de Usuarios";
      
}

<div class="container mt-4">
    <!-- Contenedor unificado para título, formulario de búsqueda y tabla -->
    <div class="unified-container border rounded shadow-sm">
        <!-- Contenedor para título y botones -->
        <div class="title-container border rounded p-3 mbb-3">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="mb-0">Lista de Correos de Usuarios</h1>
                <div>
                    <button type="button" class="btn btn-primarys btn-sm me-2" data-bs-toggle="modal" data-bs-target="#createModal">
                        <i class="fa fa-plus"></i> Nuevo Registro
                    </button>
                    
                </div>

                
            </div>

        </div>

        <!-- Contenedor para el formulario de búsqueda -->
        <div class="search-container border rounded p-3 mbb-3">
            <form asp-controller="Correousuarios" asp-action="Index" method="get" class="form-inline mb-0">
                <div class="form-group mb-0 d-flex align-items-center">
                    <input type="text" name="buscar" class="form-control form-control-sm" placeholder="Buscar" style="width: 300px;" />
                    <button type="submit" class="btn btn-light btn-sm ml-2 d-flex align-items-center">
                        <i class="fa fa-search" style="color: gray;"></i>
                    </button>

                </div>
            </form>
        </div>

        <!-- Contenedor para la tabla -->
        <div class="table-responsive border rounded p-3">
            <div class="d-flex align-items-center mb-3" style="margin-left: 10px;">
                <div class="select-all-container me-3">
                    <input type="checkbox" id="select-all" style="margin-right: 10px;" />
                    <label for="select-all" class="ms-2">Seleccionar todos</label>                  
                </div>

                <div class="ms-auto">
                    <button id="sendEmailButton" class="btn btn-primarys btn-sm me-2">
                        <i class="fa fa-pencil"></i> Redactar Correo
                    </button>
                </div>
               

            </div>

            <table id="correos" class="table table-striped table-sm mb-0">
                <thead class="theadd-light">
                    <tr>
                      
                        <th>
                            Correo Usuario
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.IdUsuarioNavigation.NombreUsuario)
                        </th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-items">
                                <input type="checkbox" class="select-checkbox"  data-email="@item.CorreoUsuario1" style="margin-right: 10px;" />
                                @Html.DisplayFor(modelItem => item.CorreoUsuario1)
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.IdUsuarioNavigation.NombreUsuario)</td>
                            <td>
                                <button type="button" class="btn btn-custom-warning btn-sm mr-2" data-bs-toggle="modal" data-bs-target="#editModal" data-id="@item.IdCorreoUsuario">
                                    <i class="fa fa-pencil-alt"></i>
                                </button>

                                <a asp-action="Details" class="btn btn-custom-primary btn-sm mr-2" asp-route-id="@item.IdCorreoUsuario">
                                    <i class="fa fa-eye"></i>
                                </a>

                                <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.IdCorreoUsuario">
                                    <i class="fa fa-trash-alt"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <div class="d-flex justify-content-between align-items-center mt-4">
            <div>
                @{
                    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
                    var totalPages = ViewData["TotalPages"] as int? ?? 1;
                }
                <a class="btn btn-light btn-sm @(currentPage == 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(currentPage - 1)">
                    <i class="fa fa-chevron-left"></i>
                </a>
                <span>Página @currentPage de @totalPages</span>
                <a class="btn btn-light btn-sm @(currentPage == totalPages ? "disabled" : "")" asp-action="Index" asp-route-page="@(currentPage + 1)">
                    <i class="fa fa-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Modales para Crear, Editar y Eliminar -->
<!-- Modal para Crear -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createModalLabel">Crear Correo de Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modal-form-container">
                    <!-- El contenido del formulario se cargará aquí mediante AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Editar -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Editar Correo de Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modal-edit-form-container">
                    <!-- El contenido del formulario de edición se cargará aquí mediante AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Eliminar -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Eliminar Correo de Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modal-delete-form-container">
                    <!-- El contenido del formulario de eliminación se cargará aquí mediante AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>


    <script>
        $(document).ready(function () {

            $('#createModal').on('show.bs.modal', function () {
                var modal = $(this);
                $.ajax({
                    url: '@Url.Action("Create", "Correousuarios")',
                    type: 'GET',
                    success: function (data) {
                        modal.find('.modal-body #modal-form-container').html(data);
                    }
                });
            });

            $('#editModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var modal = $(this);
                $.ajax({
                    url: '@Url.Action("Edit", "Correousuarios")/' + id,
                    type: 'GET',
                    success: function (data) {
                        modal.find('.modal-body #modal-edit-form-container').html(data);
                    }
                });
            });

            $('#deleteModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var modal = $(this);
                $.ajax({
                    url: '@Url.Action("Delete", "Correousuarios")/' + id,
                    type: 'GET',
                    success: function (data) {
                        modal.find('.modal-body #modal-delete-form-container').html(data);
                    }
                });
            });
        });
        var individualCheckboxes = document.querySelectorAll('.select-checkbox');

        // Lógica para seleccionar/deseleccionar todos los checkboxes
        document.getElementById('select-all').addEventListener('change', function () {
            individualCheckboxes.forEach(function (checkbox) {
                checkbox.checked = this.checked;
            }, this);
        });

        // Asegurar que el checkbox principal se actualice según las selecciones individuales
        individualCheckboxes.forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var allChecked = document.querySelectorAll('.select-checkbox:checked').length === individualCheckboxes.length;
                document.getElementById('select-all').checked = allChecked;
            });
        });

        // Evento para el botón de enviar correos
        document.getElementById('sendEmailButton').addEventListener('click', function (event) {
            event.preventDefault();

            var selectedEmails = [];
            individualCheckboxes.forEach(function (checkbox) {
                if (checkbox.checked) {
                    selectedEmails.push(checkbox.getAttribute('data-email'));
                }
            });

            if (selectedEmails.length === 0) {
                alert("Por favor, selecciona al menos un correo.");
                return;
            }

            // Serializar los correos seleccionados y redirigir a la acción SendEmail
            var queryString = new URLSearchParams({ correosSeleccionados: selectedEmails.join(',') }).toString();
            window.location.href = '@Url.Action("SendEmail", "Correousuarios")?' + queryString;
        });

         $(document).ready(function () {
            $('#correos').DataTable({
                dom: 'Brt', 
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: 'Exportar Excel',
                        filename: 'Reporte_Listado_Correos',
                        title: 'Lista de Correos de Usuario',
                        exportOptions: {
                            columns: [0, 1, 2] 
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: 'Exportar PDF',
                        filename: 'Reporte_Listado_Correos',
                        title: 'Lista de Correos de Usuario',
                        exportOptions: {
                            columns: [0, 1, 2] 
                        }
                    },
                    {
                        extend: 'print',
                        text: 'Imprimir',
                        exportOptions: {
                            columns: [0, 1, 2] 
                        }
                    }
                ],
                searching: false, 
                paging: false,     
                info: false, 
                before: false
            });
        });


    </script>
}
