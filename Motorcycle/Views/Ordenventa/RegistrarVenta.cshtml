@model Motorcycle.ViewModel.RegistrarVentaViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Ordenventum";
}

<div class="container mt-4">

    <div class="col-md-13">
            <div class="card card-primar">
              <div class="card-header">
                <h3 class="mb-0">Registrar Venta</h3>
              </div>
             
            <div class="card-body">
                <div class="row">
                    <form asp-controller="Ordenventa" asp-action="RegistrarVenta" method="post" class="form-inline mb-0">

                        <div class="col-lg-2">
                            <div class="form-group">
                                <label asp-for="IdCliente" class="control-label">Cliente</label>
                                <select asp-for="IdCliente" class="form-control" asp-items="ViewBag.IdCliente"></select>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="IdProducto" class="control-label">Producto</label>
                                <select asp-for="IdProducto" class="form-control" asp-items="ViewBag.IdProducto"></select>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="form-group">
                                <label asp-for="Cantidad" class="control-label">Cantidad</label>
                                <input asp-for="Cantidad" class="form-control" />
                            </div>
                            
                        </div>
                        <div class="col-lg-3">
                            <button type="submit" class="btn btn-primarys btn-sm ml-2 d-flex align-items-center">
                                <i class="fa fa-plus"></i>Agregar
                            </button>

                        </div>

                    </form>
                </div>          
            </div>
            </div>         
          </div>
    <div class="unified-container border rounded shadow-sm">
       


        <!-- Contenedor para la tabla -->
        <div class="table-responsive border rounded p-3">
            <table class="table table-striped table-sm mb-0">
                <thead class="theadd-light">
                    <tr>
                 
                        <th>Producto</th>
                        <th>Valor</th>
                        <th>Cantidad</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Productos)
                    {
                        <tr>
                            <td class="align-items">
                          
                                @Html.DisplayFor(modelItem => item.NombreProducto)
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Valor)</td>
                            <td>@Html.DisplayFor(modelItem => item.Cantidad)</td>
                            <td>2000</td>
                            
                        </tr>
                    }
                </tbody>
            </table>
        </div>
       
        <div class="col-lg-12">
            <form asp-controller="Ordenventa" asp-action="AgregarOrdenVenta" method="post" class="form-inline mb-0">
                
                <div class="col-lg-1">
                    <a class="btn btn-custom-primary btn-sm mr-2" href="@Url.Action("Index")">
                        <i class="fa fa-arrow-left"></i> Back
                    </a>
                </div>
                <div class="col-lg-2">
                    <button type="submit" class="btn btn-custom-warning btn-sm mr-2 d-flex align-items-center">
                        <i class="fa fa-shopping-cart"></i> Registrar
                    </button>
                </div>
               
            </form>
            
        </div>
        <!-- Paginación -->
        <div class="d-flex justify-content-between align-items-center mt-4">
            <div>
                @{
                    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
                    var totalPages = ViewData["TotalPages"] as int? ?? 1;
                }
                <a class="btn btn-light btn-sm @(currentPage == 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(currentPage - 1)">
                    <i class="fa fa-chevron-left"></i>
                </a>
                <span>Página @currentPage de @totalPages</span>
                <a class="btn btn-light btn-sm @(currentPage == totalPages ? "disabled" : "")" asp-action="Index" asp-route-page="@(currentPage + 1)">
                    <i class="fa fa-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>




